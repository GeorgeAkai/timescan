# Copy to .env.local and fill in. Required by /api/scan.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any vision-capable model id from https://openrouter.ai/models
# Structured outputs (json_schema) give the most reliable results.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional: response token ceiling (default 4096). OpenRouter reserves this
# against your credit balance up front, so lower it on a low-credit account.
OPENROUTER_MAX_TOKENS=

# Optional: attribution shown on your OpenRouter activity page.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=TimeScan
